---
interface Props {
  pageId: string;
}
const { pageId } = Astro.props;

const reactions = [
  { key: "thumbs_up", emoji: "👍", label: "Like" },
  { key: "heart", emoji: "❤️", label: "Love" },
  { key: "fire", emoji: "🔥", label: "Fire" },
  { key: "clap", emoji: "👏", label: "Applause" },
  { key: "think", emoji: "🤔", label: "Thoughtful" },
];
---

<div class="mt-10 pt-8 border-t border-neutral-500/10">
  <p class="text-sm opacity-40 mb-4">React to this post</p>
  <div
    id="reaction-container"
    data-page-id={pageId}
    class="flex gap-2 flex-wrap"
  >
    {
      reactions.map((r) => (
        <button
          data-emoji={r.key}
          data-selected="false"
          title={r.label}
          class="reaction-btn group flex items-center gap-1.5 px-3 py-2 rounded-full border border-neutral-500/20 hover:border-neutral-500/40 transition-all duration-200 cursor-pointer bg-transparent"
        >
          <span class="emoji-icon text-base transition-transform duration-200 group-hover:scale-125">
            {r.emoji}
          </span>
          <span class="reaction-count text-xs opacity-50 tabular-nums min-w-[1ch]">
            0
          </span>
        </button>
      ))
    }
  </div>
</div>

<script>
  import { db } from "../lib/firebase";
  import { doc, getDoc, setDoc, increment } from "firebase/firestore";

  function initReactions() {
    const container = document.getElementById("reaction-container");
    if (!container) return;

    const pageId = container.dataset.pageId!;
    const storageKey = `reactions_${pageId}`;
    const buttons =
      container.querySelectorAll<HTMLButtonElement>(".reaction-btn");

    // Load user's selected reactions from localStorage
    let userReactions: string[] = JSON.parse(
      localStorage.getItem(storageKey) || "[]"
    );

    function updateSelectedState() {
      buttons.forEach((btn) => {
        const emoji = btn.dataset.emoji!;
        const isSelected = userReactions.includes(emoji);
        btn.dataset.selected = isSelected ? "true" : "false";
      });
    }

    updateSelectedState();

    // Fetch counts from Firestore
    async function fetchCounts() {
      try {
        const docRef = doc(db, "page_reactions", pageId);
        const docSnap = await getDoc(docRef);
        if (docSnap.exists()) {
          const data = docSnap.data();
          buttons.forEach((btn) => {
            const emoji = btn.dataset.emoji!;
            const countEl = btn.querySelector(".reaction-count");
            if (countEl && data[emoji] != null) {
              countEl.textContent = data[emoji].toString();
            }
          });
        }
      } catch (e) {
        console.error("Error fetching reactions:", e);
      }
    }

    fetchCounts();

    // Handle reaction clicks
    buttons.forEach((btn) => {
      btn.addEventListener("click", async () => {
        const emoji = btn.dataset.emoji!;
        const countEl = btn.querySelector(".reaction-count")!;
        let currentCount = parseInt(countEl.textContent || "0");
        let delta: number;

        if (userReactions.includes(emoji)) {
          // Remove reaction
          userReactions = userReactions.filter((r) => r !== emoji);
          currentCount = Math.max(0, currentCount - 1);
          delta = -1;
        } else {
          // Add reaction
          userReactions.push(emoji);
          currentCount += 1;
          delta = 1;
        }

        // Optimistic UI update
        countEl.textContent = currentCount.toString();
        localStorage.setItem(storageKey, JSON.stringify(userReactions));
        updateSelectedState();

        // Brief pop animation on the emoji
        const emojiEl = btn.querySelector(".emoji-icon") as HTMLElement;
        if (emojiEl) {
          emojiEl.style.transform = "scale(1.3)";
          setTimeout(() => {
            emojiEl.style.transform = "";
          }, 180);
        }

        // Persist to Firestore
        try {
          const docRef = doc(db, "page_reactions", pageId);
          await setDoc(docRef, { [emoji]: increment(delta) }, { merge: true });
        } catch (e) {
          console.error("Error recording reaction:", e);
        }
      });
    });
  }

  initReactions();
</script>

<style>
  .reaction-btn[data-selected="true"] {
    background-color: rgb(115 115 115 / 0.12);
    border-color: rgb(115 115 115 / 0.35);
  }

  .reaction-btn[data-selected="true"] .reaction-count {
    opacity: 0.8;
  }
</style>
